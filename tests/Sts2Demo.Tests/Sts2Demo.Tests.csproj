<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(STS2_GAME_DIR)</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Sts2Demo/Core/DemoSession.cs" Link="DemoSession.cs" />
    <Compile Include="../../src/Sts2Demo/Networking/DemoMessages.cs" Link="DemoMessages.cs" />
    <Compile Include="../../src/Sts2Demo/Networking/DemoTargetingState.cs" Link="DemoTargetingState.cs" />
    <Compile Include="../../src/Sts2Demo/Networking/DemoRewardMessage.cs" Link="DemoRewardMessage.cs" />
    <Compile Include="../../src/Sts2Demo/Networking/DemoScreenMessage.cs" Link="DemoScreenMessage.cs" />
    <Compile Include="../../src/Sts2Demo/Core/DemoScreenAssembly.cs" Link="DemoScreenAssembly.cs" />
    <Compile Include="../../src/Sts2Demo/Core/DemoScreenPolicy.cs" Link="DemoScreenPolicy.cs" />
    <Compile Include="../../src/Sts2Demo/Core/DemoInputPolicy.cs" Link="DemoInputPolicy.cs" />
    <Compile Include="../../src/Sts2Demo/Core/DemoVisualState.cs" Link="DemoVisualState.cs" />
    <Compile Include="../../src/Sts2Demo/Core/DemoRewardLayout.cs" Link="DemoRewardLayout.cs" />
    <Compile Include="../../src/Sts2Demo/Core/DemoArrowLayout.cs" Link="DemoArrowLayout.cs" />
    <Reference Include="sts2"><HintPath>$(GameDir)/data_sts2_windows_x86_64/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDir)/data_sts2_windows_x86_64/GodotSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
