<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(STS2_GAME_DIR)</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Sts2Demo/Core/DemoSession.cs" Link="DemoSession.cs" />
    <Compile Include="../../src/Sts2Demo/Networking/DemoMessages.cs" Link="DemoMessages.cs" />
    <Compile Include="../../src/Sts2Demo/Networking/DemoRewardMessage.cs" Link="DemoRewardMessage.cs" />
    <Reference Include="sts2"><HintPath>$(GameDir)/data_sts2_windows_x86_64/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDir)/data_sts2_windows_x86_64/GodotSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
